{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/format-edited-file.sh\"",
            "timeout": 60,
            "statusMessage": "Formatting with prettier"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/registry-parity.sh\"",
            "timeout": 20,
            "statusMessage": "Checking registry parity"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/guard-commit.sh\"",
            "if": "Bash(git commit*)",
            "timeout": 60,
            "statusMessage": "Checking commit message and staged diff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/typecheck-on-stop.sh\"",
            "timeout": 300,
            "statusMessage": "Typechecking the workspace"
          }
        ]
      }
    ]
  }
}
